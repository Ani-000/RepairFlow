
:root {
  --navy: #17243a;
  --navy-2: #243651;
  --blue: #3267d6;
  --blue-dark: #2556bf;
  --ink: #17243a;
  --muted: #7d899a;
  --line: #e7ebf1;
  --surface: #fff;
  --bg: #f5f7fb;
  --green: #13845e;
  --red: #c33d4b;
  --shadow: 0 8px 28px rgba(24, 43, 72, .055);

  --control-border: #d9e0e9;
  --control-border-hover: #b8c5d6;
  --control-focus: #3267d6;
  --control-height: 45px;
}

/* =========================================================
   APPLICATION SHELL
   ========================================================= */

.app-shell {
  min-height: 100vh;
  display: flex;
  background: var(--bg);
}

.sidebar {
  width: 248px;
  background: var(--navy);
  color: #d5deeb;
  display: flex;
  flex-direction: column;
  padding: 27px 17px 18px;
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 5;
}

.brand,
.auth-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font: 800 20px Manrope, sans-serif;
  letter-spacing: -.7px;
  color: #fff;
}

.brand {
  padding: 0 10px 38px;
}

.brand-accent {
  color: #78a8ff;
}

.brand-mark {
  height: 31px;
  width: 31px;
  border-radius: 9px;
  background: #4b80eb;
  display: grid;
  place-items: center;
  color: #fff;
  font: 800 19px Manrope, sans-serif;
  box-shadow: 0 5px 14px #0b1b35;
}

.sidebar-label,
.eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.35px;
  color: #94a1b3;
}

.sidebar-label {
  padding: 0 12px 12px;
}

.side-nav {
  display: grid;
  gap: 6px;
}

.nav-link {
  height: 44px;
  border-radius: 8px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: #b9c5d5;
  font-size: 13px;
  font-weight: 600;
  transition: .18s;
}

.nav-link:hover {
  background: #263955;
  color: #fff;
}

.nav-link.active {
  background: #304d78;
  color: #fff;
  box-shadow: inset 3px 0 #77a6ff;
}

.nav-icon {
  font-size: 17px;
  width: 19px;
  text-align: center;
}

.sidebar-bottom {
  margin-top: auto;
}

.profile-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  border-top: 1px solid #34445b;
  padding: 20px 7px 13px;
}

.avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #385d92;
  color: #fff;
  display: grid;
  place-items: center;
  font-weight: 700;
}

.profile-copy {
  display: grid;
  gap: 3px;
  min-width: 0;
}

.profile-copy strong {
  font-size: 12px;
  color: #f4f7fb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-copy span {
  font-size: 10px;
  color: #9eacbf;
  text-transform: capitalize;
}

.logout-button {
  width: 100%;
  background: none;
  border: 0;
  color: #aebbd0;
  text-align: left;
  padding: 10px 9px;
  font-size: 12px;
  cursor: pointer;
}

.logout-button:hover {
  color: #fff;
}

.logout-button span {
  margin-left: 9px;
}

.main-area {
  width: calc(100% - 248px);
  margin-left: 248px;
  min-height: 100vh;
}

.topbar {
  height: 64px;
  background: #fff;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 38px;
}

.breadcrumb {
  font-size: 12px;
  color: #718096;
}

.breadcrumb span {
  padding: 0 9px;
  color: #c1c9d4;
}

.topbar-right {
  font-size: 11px;
  color: #748196;
  display: flex;
  align-items: center;
  gap: 8px;
}

.online-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #25ad7a;
  box-shadow: 0 0 0 3px #e3f6ee;
}

.page-content {
  max-width: 1500px;
  margin: 0 auto;
  padding: 36px 40px 55px;
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 27px;
}

.page-heading h1,
.auth-card h2,
.not-found h1 {
  font: 800 28px Manrope, sans-serif;
  letter-spacing: -1px;
  color: var(--ink);
  margin: 8px 0 6px;
}

.page-heading p,
.form-subtitle {
  font-size: 13px;
  color: var(--muted);
  margin: 0;
}

.eyebrow {
  color: #7185a2;
}

.eyebrow.light {
  color: #9ab6e4;
}

/* =========================================================
   BUTTONS
   ========================================================= */

.primary-button,
.secondary-button,
.danger-button {
  border: 0;
  border-radius: 8px;
  padding: 12px 16px;
  font-size: 12px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  transition: background .18s ease, box-shadow .18s ease;
  white-space: nowrap;
  cursor: pointer;
}

.primary-button {
  background: var(--blue);
  color: #fff;
  box-shadow: 0 5px 12px rgba(50, 103, 214, .16);
}

.primary-button:hover {
  background: var(--blue-dark);
  box-shadow: 0 4px 12px rgba(50, 103, 214, .19);
}

.primary-button span {
  font-size: 16px;
}

.secondary-button {
  background: #fff;
  border: 1px solid #dce3ed;
  color: #52637b;
}

.secondary-button:hover {
  border-color: #9fb2d0;
  background: #fafdff;
}

.danger-button {
  background: #fff1f1;
  color: #b83243;
  border: 1px solid #f4d3d6;
}

.danger-button:hover {
  background: #ffe6e8;
}

.full {
  width: 100%;
}

.small-button {
  border: 0;
  border-radius: 7px;
  background: #eaf0fc;
  color: #2858b5;
  font-size: 11px;
  font-weight: 700;
  padding: 9px 13px;
  cursor: pointer;
  transition: background .16s ease;
}

.small-button:hover {
  background: #dce7fb;
}

.small-button:disabled {
  opacity: .5;
  cursor: not-allowed;
}

.admin-greeting {
  font-size: 11px;
  color: var(--muted);
}

.admin-greeting strong {
  color: #44546b;
}

/* =========================================================
   METRICS AND DATA PANELS
   ========================================================= */

.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 23px;
}

.metric-grid.three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.metric-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 17px 19px;
  box-shadow: var(--shadow);
  min-height: 117px;
}

.metric-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #758297;
  font-size: 11px;
  font-weight: 600;
}

.metric-icon {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: #edf3ff;
  color: #4777d6;
  display: grid;
  place-items: center;
  font-size: 15px;
}

.metric-card > strong {
  display: block;
  font: 800 25px Manrope, sans-serif;
  color: var(--ink);
  margin: 8px 0 2px;
}

.metric-card > small {
  font-size: 10px;
  color: #9aa5b4;
}

.panel,
.form-panel {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 10px;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.panel {
  margin-bottom: 20px;
}

.panel-heading {
  padding: 20px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border-bottom: 1px solid #edf0f4;
}

.panel-heading h2,
.section-title h2 {
  font: 700 15px Manrope, sans-serif;
  margin: 0 0 5px;
  color: var(--ink);
}

.panel-heading p,
.section-title p {
  font-size: 11px;
  color: var(--muted);
  margin: 0;
}

.count-pill {
  border-radius: 20px;
  background: #f1f4f8;
  color: #738096;
  padding: 6px 10px;
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
}

.table-wrap {
  width: 100%;
  overflow-x: auto;
}

.data-table {
  border-collapse: collapse;
  width: 100%;
  min-width: 760px;
  text-align: left;
}

.data-table th {
  background: #fafbfd;
  color: #8994a4;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .8px;
  padding: 13px 17px;
  white-space: nowrap;
}

.data-table td {
  padding: 14px 17px;
  border-top: 1px solid #f0f2f5;
  color: #536176;
  font-size: 11px;
  white-space: nowrap;
}

.data-table tbody tr:hover {
  background: #fbfcff;
}

.ticket-link {
  color: #2e61c5;
  font-weight: 700;
}

.ticket-link:hover {
  text-decoration: underline;
}

.device-cell {
  display: grid;
  gap: 4px;
}

.device-cell strong {
  font-size: 11px;
  color: #33445d;
}

.device-cell span,
.muted {
  font-size: 10px;
  color: #929eae;
}

.table-subtext {
  margin-top: 4px;
}

.table-action {
  font-size: 11px;
  font-weight: 700;
  color: #3569ce;
}

.table-action:hover {
  text-decoration: underline;
}

/* =========================================================
   STATUS BADGES
   ========================================================= */

.status-badge {
  display: inline-flex;
  align-items: center;
  border-radius: 20px;
  padding: 5px 8px;
  font-size: 9px;
  font-weight: 700;
  white-space: nowrap;
  background: #eef2f7;
  color: #65748a;
}

.status-received {
  background: #edf3ff;
  color: #3868bd;
}

.status-diagnosing {
  background: #f2edff;
  color: #7553bb;
}

.status-awaiting-approval {
  background: #fff5df;
  color: #a4751f;
}

.status-in-repair {
  background: #e9f3ff;
  color: #2872b4;
}

.status-ready-for-pickup {
  background: #e9f8f0;
  color: #218052;
}

.status-completed {
  background: #e7f6ef;
  color: #178052;
}

.status-cancelled {
  background: #fff0f0;
  color: #b84a54;
}

/* =========================================================
   EMPTY AND LOADING STATES
   ========================================================= */

.empty-state,
.loading-state {
  text-align: center;
  padding: 43px 20px;
  color: #8591a2;
  font-size: 12px;
}

.empty-state strong {
  display: block;
  color: #45546a;
  font-size: 13px;
  margin: 10px 0 5px;
}

.empty-state p {
  margin: 0;
  font-size: 11px;
}

.empty-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #f0f4fa;
  color: #7890b5;
  display: grid;
  place-items: center;
  margin: 0 auto;
  font-size: 17px;
}

.empty-state.compact {
  padding: 25px 12px;
}

/* =========================================================
   FORMS AND INPUT CONTROLS
   ========================================================= */

.form-panel {
  max-width: 900px;
  padding: 26px 28px;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin: 24px 0;
}

/* Existing form labels */

.form-panel form > label,
.auth-card label,
.inline-action label {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8px;
  font-size: 12px;
  font-weight: 600;
  color: #45546a;
}

/* Consistent input styling */

.form-panel input,
.form-panel select,
.form-panel textarea,
.auth-card input,
.inline-action input,
.inline-action textarea,
.assign-control select,
.staff-form input,
.staff-form select,
.data-table select {
  width: 100%;
  min-width: 0;
  min-height: var(--control-height);
  box-sizing: border-box;
  border: 1px solid var(--control-border);
  border-radius: 8px;
  background: #fff;
  color: #26364c;
  padding: 11px 13px;
  font: inherit;
  font-size: 13px;
  outline: none;
  transition: border-color .16s ease, box-shadow .16s ease;
}

.form-panel input:hover,
.form-panel select:hover,
.auth-card input:hover,
.inline-action input:hover,
.assign-control select:hover,
.staff-form input:hover,
.staff-form select:hover,
.data-table select:hover {
  border-color: var(--control-border-hover);
}

.form-panel input:focus,
.form-panel select:focus,
.form-panel textarea:focus,
.auth-card input:focus,
.inline-action input:focus,
.inline-action textarea:focus,
.assign-control select:focus,
.staff-form input:focus,
.staff-form select:focus,
.data-table select:focus {
  border-color: var(--control-focus);
  box-shadow: 0 0 0 3px rgba(50, 103, 214, .11);
}

.form-panel textarea,
.inline-action textarea {
  resize: vertical;
  line-height: 1.55;
}

.form-panel input::placeholder,
.form-panel textarea::placeholder,
.auth-card input::placeholder,
.staff-form input::placeholder {
  color: #a0aaba;
}

.form-panel select,
.staff-form select,
.data-table select,
.assign-control select {
  cursor: pointer;
}

/* Staff creation form */

.staff-panel {
  margin-bottom: 22px;
}

.staff-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 21px 28px;
  margin: 24px 22px;
}

.staff-form > label {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8px;
  min-width: 0;
  color: #45546a;
  font-size: 12px;
  font-weight: 600;
}

.staff-form > label > span {
  line-height: 1.4;
}

.staff-submit {
  width: min(100%, 330px);
  min-height: 47px;
  align-self: end;
}

.staff-requirement {
  margin: 4px 22px 20px;
  line-height: 1.5;
  font-size: 10px;
  color: #929eae;
}

/* Existing form sections */

.section-title {
  display: flex;
  align-items: center;
  gap: 12px;
}

.step-number {
  height: 29px;
  width: 29px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: #edf3ff;
  color: #3568cc;
  font: 700 11px Manrope;
}

.section-gap {
  margin: 28px 0 17px;
}

.form-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-top: 25px;
  padding-top: 20px;
  border-top: 1px solid #edf0f4;
}

.form-footer > span {
  font-size: 10px;
  color: #8d99a9;
}

.form-footer .primary-button {
  margin-left: auto;
}

/* =========================================================
   ASSIGNMENT CONTROLS AND REPAIR TABLE
   ========================================================= */

.assign-control {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 235px;
}

.assign-control select {
  flex: 1;
  width: auto;
  min-width: 130px;
}

.assign-control .small-button {
  flex: 0 0 auto;
  min-height: 39px;
}

.repair-operations-table {
  min-width: 1050px;
}

.repair-operations-table th:nth-child(1) {
  min-width: 145px;
}

.repair-operations-table th:nth-child(2) {
  min-width: 125px;
}

.repair-operations-table th:nth-child(3) {
  min-width: 115px;
}

.repair-operations-table th:nth-child(4) {
  min-width: 135px;
}

.repair-operations-table th:nth-child(5) {
  min-width: 255px;
}

.repair-operations-table th:nth-child(6) {
  min-width: 125px;
}

.repair-row-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* =========================================================
   ALERTS
   ========================================================= */

.alert {
  padding: 11px 13px;
  border-radius: 7px;
  font-size: 11px;
  margin: 15px 0;
}

.alert.error {
  background: #fff0f0;
  border: 1px solid #f4d4d7;
  color: #b13e4a;
}

.alert.success {
  background: #edfaf3;
  border: 1px solid #d2efdf;
  color: #18764e;
}

/* =========================================================
   AUTHENTICATION CARD
   ========================================================= */

.auth-card small {
  font-size: 10px;
  font-weight: 400;
  color: #8995a6;
}

.auth-card label {
  margin: 19px 0;
}

.auth-card input {
  margin-top: 1px;
}

.auth-card .primary-button {
  margin-top: 8px;
  padding: 14px;
}

/* =========================================================
   REPAIR DETAIL SCREEN
   ========================================================= */

.heading-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(280px, .9fr);
  gap: 17px;
  align-items: start;
}

.detail-main {
  padding-bottom: 22px;
}

.detail-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px 25px;
  padding: 23px;
}

.detail-field {
  display: grid;
  gap: 6px;
}

.field-label {
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .75px;
  color: #8c98a8;
  font-weight: 700;
}

.detail-field strong {
  font-size: 12px;
  font-weight: 600;
  color: #3a4a61;
}

.description-block {
  margin: 0 23px;
  padding: 16px;
  background: #f8fafd;
  border: 1px solid #edf1f6;
  border-radius: 7px;
}

.description-block p {
  margin: 8px 0 0;
  font-size: 12px;
  line-height: 1.65;
  color: #58677b;
  white-space: pre-wrap;
}

.action-section {
  margin: 23px 23px 0;
  padding-top: 19px;
  border-top: 1px solid #edf0f4;
}

.action-section h3 {
  font: 700 13px Manrope, sans-serif;
  margin: 0 0 13px;
}

.action-section > p {
  font-size: 11px;
  color: #65748a;
  line-height: 1.55;
}

.inline-action {
  display: grid;
  gap: 12px;
  margin-top: 12px;
}

.inline-action .primary-button {
  justify-self: start;
}

.button-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.history-panel {
  padding-bottom: 16px;
}

.timeline {
  padding: 21px 22px 5px;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 15px 1fr;
  gap: 10px;
  padding-bottom: 23px;
}

.timeline-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 5px;
  top: 13px;
  bottom: 0;
  width: 1px;
  background: #e5eaf1;
}

.timeline-dot {
  height: 11px;
  width: 11px;
  border-radius: 50%;
  background: #6f94dc;
  border: 3px solid #e8effc;
  z-index: 1;
  margin-top: 3px;
}

.timeline-item > div {
  display: grid;
  justify-items: start;
  gap: 7px;
}

.timeline-item time {
  font-size: 9px;
  color: #9aa5b3;
}

.timeline-item p {
  font-size: 11px;
  color: #58677b;
  margin: 0;
  line-height: 1.5;
}

.timeline-item small {
  font-size: 9px;
  color: #98a3b1;
}

.approval-box {
  background: #fffaf0;
  border: 1px solid #f3e6c9;
  border-radius: 8px;
  padding: 16px;
  margin: 20px 23px 0;
}

.approval-box h3 {
  margin-top: 0;
}

.approval-box p {
  font-size: 11px;
  color: #6f6041;
  line-height: 1.6;
}

/* =========================================================
   AUTHENTICATION PAGES
   ========================================================= */

.auth-page {
  min-height: 100vh;
  display: grid;
  grid-template-columns: minmax(350px, .95fr) minmax(450px, 1.05fr);
  background: #fff;
}

.auth-visual {
  background: linear-gradient(
    145deg,
    #152943 0%,
    #1d3c65 60%,
    #25518b 100%
  );
  color: #fff;
  padding: 35px 9%;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.auth-visual::after {
  content: '';
  position: absolute;
  width: 480px;
  height: 480px;
  border: 1px solid rgba(255, 255, 255, .08);
  border-radius: 50%;
  right: -220px;
  bottom: -180px;
  box-shadow:
    0 0 0 45px rgba(255, 255, 255, .025),
    0 0 0 90px rgba(255, 255, 255, .02);
}

.auth-brand {
  position: relative;
  z-index: 1;
}

.visual-content {
  position: relative;
  z-index: 1;
  margin: auto 0;
  max-width: 460px;
  padding: 70px 0;
}

.visual-content h1 {
  font: 800 clamp(38px, 4.3vw, 59px)/1.12 Manrope, sans-serif;
  letter-spacing: -2.5px;
  margin: 20px 0;
}

.visual-content h1 span {
  color: #83b0ff;
}

.visual-content p {
  max-width: 390px;
  color: #bdcce0;
  font-size: 14px;
  line-height: 1.8;
}

.visual-stats {
  display: flex;
  gap: 27px;
  margin-top: 47px;
}

.visual-stats div {
  display: grid;
  gap: 5px;
}

.visual-stats strong {
  font: 800 22px Manrope, sans-serif;
  color: #fff;
}

.visual-stats span {
  font-size: 9px;
  color: #a9bad1;
}

.visual-footer {
  position: relative;
  z-index: 1;
  font-size: 9px;
  letter-spacing: 1.5px;
  color: #8fa7c5;
}

.auth-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 55px 35px;
  position: relative;
}

.auth-card {
  width: 100%;
  max-width: 385px;
}

.auth-card h2 {
  font-size: 25px;
  margin-top: 12px;
}

.auth-card .form-subtitle {
  margin-bottom: 30px;
}

.auth-switch {
  text-align: center;
  color: #8793a3;
  font-size: 11px;
  margin-top: 23px;
}

.auth-switch a {
  color: #3267d6;
  font-weight: 700;
}

.auth-legal {
  position: absolute;
  bottom: 22px;
  color: #a2acb9;
  font-size: 9px;
}

.register-page .visual-content {
  padding: 40px 0;
}

.not-found {
  min-height: 70vh;
  display: grid;
  align-content: center;
  justify-items: center;
  text-align: center;
}

.not-found p {
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 22px;
}

/* =========================================================
   SKELETON LOADING
   ========================================================= */

.skeleton {
  position: relative;
  overflow: hidden;
  border-radius: 6px;
  background: #edf0f4;
}

.skeleton::after {
  content: '';
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, .7),
    transparent
  );
  animation: skeleton-shimmer 1.5s infinite;
}

@keyframes skeleton-shimmer {
  to {
    transform: translateX(100%);
  }
}

/* Metric skeleton cards */

.skeleton-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 13px;
}

.skeleton-label {
  width: 48%;
  height: 11px;
}

.skeleton-value {
  width: 32%;
  height: 27px;
  border-radius: 5px;
}

.skeleton-note {
  width: 68%;
  height: 9px;
}

/* Table skeleton */

.skeleton-table-wrap {
  padding: 0 0 5px;
  overflow-x: auto;
}

.skeleton-table {
  min-width: 650px;
}

.skeleton-table-header,
.skeleton-table-row {
  display: grid;
  grid-template-columns: repeat(
    var(--skeleton-columns, 5),
    minmax(0, 1fr)
  );
  align-items: center;
  gap: 18px;
  padding: 15px 18px;
}

.skeleton-table-header {
  background: #fafbfd;
  border-bottom: 1px solid var(--line);
}

.skeleton-table-row {
  border-bottom: 1px solid #f0f2f5;
}

.skeleton-cell {
  width: 80%;
  height: 12px;
}

.skeleton-table-row:nth-child(even) .skeleton-cell {
  width: 65%;
}

/* Screen-reader-only text */

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* =========================================================
   ACCESSIBILITY
   ========================================================= */

button:focus-visible,
a:focus-visible,
select:focus-visible,
input:focus-visible,
textarea:focus-visible {
  outline: 3px solid rgba(50, 103, 214, .2);
  outline-offset: 2px;
}

button:disabled {
  cursor: not-allowed;
  opacity: .6;
}

/* =========================================================
   RESPONSIVE LAYOUT
   ========================================================= */

@media (max-width: 1100px) {
  .page-content {
    padding: 28px 25px;
  }

  .metric-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .detail-grid {
    grid-template-columns: 1fr;
  }

  .auth-page {
    grid-template-columns: .85fr 1.15fr;
  }

  .auth-visual {
    padding-left: 7%;
    padding-right: 7%;
  }
}

@media (max-width: 900px) {
  .staff-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .repair-operations-table {
    min-width: 1000px;
  }
}

@media (max-width: 760px) {
  .sidebar {
    width: 66px;
    padding: 20px 9px;
  }

  .brand {
    padding: 0 8px 35px;
    font-size: 0;
  }

  .brand-mark {
    flex: none;
  }

  .sidebar-label,
  .nav-link:not(.active),
  .nav-link {
    font-size: 0;
    justify-content: center;
    padding: 0;
  }

  .nav-link {
    height: 43px;
  }

  .nav-icon {
    font-size: 17px;
  }

  .profile-chip {
    justify-content: center;
    padding: 16px 0;
  }

  .profile-copy,
  .logout-button span {
    display: none;
  }

  .logout-button {
    text-align: center;
    padding: 10px 0;
  }

  .main-area {
    width: calc(100% - 66px);
    margin-left: 66px;
  }

  .topbar {
    padding: 0 18px;
  }

  .page-content {
    padding: 25px 16px 40px;
  }

  .page-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .page-heading h1 {
    font-size: 24px;
  }

  .page-heading > .primary-button,
  .page-heading > .secondary-button {
    align-self: flex-start;
  }

  .metric-grid,
  .metric-grid.three {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .metric-card {
    padding: 14px;
    min-height: 105px;
  }

  .panel-heading {
    padding: 16px;
  }

  .form-panel {
    padding: 20px 16px;
  }

  .form-grid {
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 19px 0;
  }

  .staff-form {
    grid-template-columns: 1fr;
    gap: 17px;
    margin: 19px 16px;
  }

  .staff-submit {
    width: 100%;
  }

  .staff-requirement {
    margin-left: 16px;
    margin-right: 16px;
  }

  .form-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .form-footer .primary-button {
    margin-left: 0;
  }

  .detail-fields {
    padding: 18px;
    gap: 18px 12px;
  }

  .description-block {
    margin: 0 16px;
  }

  .action-section {
    margin-left: 16px;
    margin-right: 16px;
  }

  .approval-box {
    margin-left: 16px;
    margin-right: 16px;
  }

  .heading-actions {
    flex-wrap: wrap;
  }

  .auth-page {
    display: block;
  }

  .auth-visual {
    min-height: 250px;
    padding: 24px 25px;
  }

  .auth-brand {
    font-size: 18px;
  }

  .visual-content {
    padding: 38px 0 25px;
    margin: 0;
  }

  .visual-content h1 {
    font-size: 35px;
    margin: 12px 0;
  }

  .visual-content p {
    font-size: 11px;
    max-width: 430px;
  }

  .visual-stats,
  .visual-footer {
    display: none;
  }

  .auth-panel {
    min-height: calc(100vh - 250px);
    padding: 38px 24px 60px;
  }

  .auth-card {
    max-width: 430px;
  }

  .auth-legal {
    bottom: 15px;
  }

  .breadcrumb {
    font-size: 10px;
  }

  .topbar-right {
    font-size: 0;
  }

  .online-dot {
    font-size: initial;
  }

  .admin-greeting {
    display: none;
  }

  .assign-control {
    min-width: 220px;
  }
}

@media (max-width: 520px) {
  .repair-row-actions {
    gap: 8px;
  }

  .skeleton-table {
    min-width: 600px;
  }
}

@media (max-width: 420px) {
  .metric-grid,
  .metric-grid.three {
    grid-template-columns: 1fr 1fr;
  }

  .metric-card > strong {
    font-size: 22px;
  }

  .metric-top {
    font-size: 10px;
  }

  .detail-fields {
    grid-template-columns: 1fr;
  }

  .count-pill {
    font-size: 9px;
  }

  .panel-heading {
    align-items: flex-start;
  }

  .auth-visual {
    min-height: 225px;
  }
}

/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  .skeleton::after {
    animation: none;
  }

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}

/* =========================================================
   REPAIRFLOW — BURGUNDY & STONE DESIGN SYSTEM
   Light, dark and system themes
   ========================================================= */

:root {
  color-scheme: light;
  --navy: #30282a;
  --navy-2: #46383b;
  --blue: #873f4b;
  --blue-dark: #71323e;
  --ink: #30282a;
  --muted: #776d6d;
  --line: #e5ddd8;
  --surface: #fffdfb;
  --bg: #f4f0ed;
  --green: #287653;
  --red: #a63e4b;
  --shadow: 0 8px 26px rgba(55, 35, 38, .055);
  --control-border: #d9cfca;
  --control-border-hover: #bca9a5;
  --control-focus: #873f4b;
  --control-height: 45px;

  --rf-bg: #f4f0ed;
  --rf-surface: #fffdfb;
  --rf-surface-soft: #f8f5f2;
  --rf-surface-raised: #ffffff;
  --rf-text: #30282a;
  --rf-text-soft: #62585a;
  --rf-muted: #827779;
  --rf-line: #e5ddd8;
  --rf-primary: #873f4b;
  --rf-primary-hover: #71323e;
  --rf-primary-soft: #f3e7e8;
  --rf-primary-text: #71323e;
  --rf-input: #fffdfb;
  --rf-shadow: 0 8px 26px rgba(55, 35, 38, .055);
}

html[data-theme="dark"] {
  color-scheme: dark;
  --navy: #211b1d;
  --navy-2: #302528;
  --blue: #b86b77;
  --blue-dark: #c47a85;
  --ink: #eee5e5;
  --muted: #b7a9ab;
  --line: #44383b;
  --surface: #2b2225;
  --bg: #20191b;
  --green: #83c6a3;
  --red: #e28a94;
  --shadow: 0 10px 30px rgba(0, 0, 0, .2);
  --control-border: #514347;
  --control-border-hover: #765d63;
  --control-focus: #c17b86;

  --rf-bg: #20191b;
  --rf-surface: #2b2225;
  --rf-surface-soft: #33282c;
  --rf-surface-raised: #382c30;
  --rf-text: #eee5e5;
  --rf-text-soft: #d0c3c5;
  --rf-muted: #ad9fa2;
  --rf-line: #44383b;
  --rf-primary: #b86b77;
  --rf-primary-hover: #ca808a;
  --rf-primary-soft: #493238;
  --rf-primary-text: #f3dfe2;
  --rf-input: #251e20;
  --rf-shadow: 0 10px 30px rgba(0, 0, 0, .2);
}

html, body, #root {
  min-height: 100%;
  background: var(--rf-bg);
}

html {
  background: var(--rf-bg);
  transition: background-color .2s ease, color .2s ease;
}

body {
  background: var(--rf-bg);
  color: var(--rf-text);
}

body, button, input, select, textarea {
  font-family: Inter, Manrope, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.app-shell,
.main-area,
.page-content,
.auth-page,
.auth-panel {
  background: var(--rf-bg);
  color: var(--rf-text);
}

.sidebar {
  background: #302326;
  color: #eee5e5;
  border-right: 1px solid rgba(255,255,255,.06);
}

html[data-theme="dark"] .sidebar {
  background: #191416;
  border-right-color: #382b2f;
}

.brand-accent { color: #d7a6ad; }
.brand-mark {
  background: #873f4b;
  box-shadow: 0 5px 14px rgba(0,0,0,.2);
}
html[data-theme="dark"] .brand-mark { background: #a95d69; }

.sidebar-label, .eyebrow { color: #a28b8e; }
.eyebrow { color: #9a626b; }
.eyebrow.light { color: #dfb7bd; }

.nav-link { color: #d1c1c4; }
.nav-link:hover { background: #49353a; color: #fff; }
.nav-link.active {
  background: #593a41;
  color: #fff;
  box-shadow: inset 3px 0 #d29aa3;
}
html[data-theme="dark"] .nav-link:hover { background: #38272c; }
html[data-theme="dark"] .nav-link.active {
  background: #493137;
  box-shadow: inset 3px 0 #c47a85;
}

.profile-chip { border-top-color: rgba(255,255,255,.13); }
.avatar { background: #873f4b; }
.profile-copy strong { color: #f6eeee; }
.profile-copy span { color: #c0adb1; }
.logout-button { color: #d1c1c4; }
.logout-button:hover { color: #fff; }

.topbar {
  background: var(--rf-surface);
  border-bottom-color: var(--rf-line);
}
.breadcrumb, .topbar-right { color: var(--rf-muted); }
.breadcrumb span { color: var(--rf-muted); }
.online-dot { background: #4d9a78; box-shadow: 0 0 0 3px rgba(77,154,120,.15); }

.page-heading h1, .auth-card h2, .not-found h1,
.panel-heading h2, .section-title h2,
.metric-card > strong, .device-cell strong,
.detail-field strong, .empty-state strong,
.admin-greeting strong, .action-section h3 {
  color: var(--rf-text);
}

.page-heading p, .form-subtitle, .panel-heading p,
.section-title p, .muted, .metric-card > small,
.metric-top, .empty-state, .loading-state,
.form-footer > span, .field-label, .timeline-item time,
.timeline-item small, .not-found p {
  color: var(--rf-muted);
}

.primary-button {
  background: var(--rf-primary);
  color: #fff;
  box-shadow: 0 5px 12px rgba(135,63,75,.15);
}
.primary-button:hover {
  background: var(--rf-primary-hover);
  box-shadow: 0 4px 12px rgba(135,63,75,.2);
}
.secondary-button {
  background: var(--rf-surface);
  border: 1px solid var(--rf-line);
  color: var(--rf-text-soft);
}
.secondary-button:hover {
  border-color: #bca9a5;
  background: var(--rf-surface-soft);
}
.danger-button {
  background: #f9eded;
  color: #a63e4b;
  border: 1px solid #efd5d8;
}
.danger-button:hover { background: #f3dfe1; }
html[data-theme="dark"] .danger-button {
  background: #492b31;
  color: #f0b6bd;
  border-color: #694049;
}
html[data-theme="dark"] .danger-button:hover { background: #58333b; }

.small-button {
  background: var(--rf-primary-soft);
  color: var(--rf-primary-text);
}
.small-button:hover { background: #ead7da; }
html[data-theme="dark"] .small-button {
  background: #493238;
  color: #f0dadd;
}
html[data-theme="dark"] .small-button:hover { background: #5a3b43; }

.metric-card, .panel, .form-panel {
  background: var(--rf-surface);
  border-color: var(--rf-line);
  box-shadow: var(--rf-shadow);
}
.metric-icon, .empty-icon, .step-number {
  background: var(--rf-primary-soft);
  color: var(--rf-primary);
}
.panel-heading { border-bottom-color: var(--rf-line); }
.count-pill {
  background: var(--rf-surface-soft);
  color: var(--rf-muted);
}
.data-table th {
  background: var(--rf-surface-soft);
  color: var(--rf-muted);
}
.data-table td {
  border-top-color: var(--rf-line);
  color: var(--rf-text-soft);
}
.data-table tbody tr:hover { background: var(--rf-surface-soft); }
.ticket-link, .table-action, .auth-switch a {
  color: var(--rf-primary);
}
.device-cell strong { color: var(--rf-text); }
.device-cell span, .muted { color: var(--rf-muted); }

html[data-theme="dark"] .data-table tbody tr:hover {
  background: #35292d;
}

.status-badge { background: #eee8e5; color: #675b5d; }
.status-received { background: #f1e6e8; color: #813f4b; }
.status-diagnosing { background: #eee8f2; color: #73577f; }
.status-awaiting-approval { background: #f5eddd; color: #8a672e; }
.status-in-repair { background: #e8edf0; color: #4e6976; }
.status-ready-for-pickup { background: #e5f0e9; color: #356c4e; }
.status-completed { background: #e2eee7; color: #2d6949; }
.status-cancelled { background: #f6e6e7; color: #a13e4a; }

html[data-theme="dark"] .status-badge { background: #40373a; color: #d5c8ca; }
html[data-theme="dark"] .status-received { background: #4a3037; color: #e8b8c0; }
html[data-theme="dark"] .status-diagnosing { background: #403348; color: #d6bce3; }
html[data-theme="dark"] .status-awaiting-approval { background: #4a3d29; color: #e6cc96; }
html[data-theme="dark"] .status-in-repair { background: #2d4149; color: #b8d5df; }
html[data-theme="dark"] .status-ready-for-pickup,
html[data-theme="dark"] .status-completed { background: #294237; color: #b7dfc7; }
html[data-theme="dark"] .status-cancelled { background: #4a2d33; color: #efb8c0; }

.form-panel form > label, .auth-card label, .inline-action label,
.staff-form > label { color: var(--rf-text-soft); }

.form-panel input, .form-panel select, .form-panel textarea,
.auth-card input, .inline-action input, .inline-action textarea,
.assign-control select, .staff-form input, .staff-form select,
.data-table select {
  background: var(--rf-input);
  color: var(--rf-text);
  border-color: var(--control-border);
}
.form-panel input:hover, .form-panel select:hover,
.auth-card input:hover, .inline-action input:hover,
.assign-control select:hover, .staff-form input:hover,
.staff-form select:hover, .data-table select:hover {
  border-color: var(--control-border-hover);
}
.form-panel input:focus, .form-panel select:focus,
.form-panel textarea:focus, .auth-card input:focus,
.inline-action input:focus, .inline-action textarea:focus,
.assign-control select:focus, .staff-form input:focus,
.staff-form select:focus, .data-table select:focus {
  border-color: var(--control-focus);
  box-shadow: 0 0 0 3px rgba(135,63,75,.13);
}
.form-panel input::placeholder, .form-panel textarea::placeholder,
.auth-card input::placeholder, .staff-form input::placeholder {
  color: var(--rf-muted);
}
html[data-theme="dark"] select option {
  background: #2b2225;
  color: #eee5e5;
}

.form-footer { border-top-color: var(--rf-line); }
.step-number { color: var(--rf-primary); }
.description-block {
  background: var(--rf-surface-soft);
  border-color: var(--rf-line);
}
.description-block p, .action-section > p,
.timeline-item p { color: var(--rf-text-soft); }
.action-section { border-top-color: var(--rf-line); }
.timeline-item:not(:last-child)::before { background: var(--rf-line); }
.timeline-dot { background: #a95d69; border-color: var(--rf-primary-soft); }
.approval-box {
  background: #f6efe2;
  border-color: #e9dcc2;
}
.approval-box p { color: #6f6041; }
html[data-theme="dark"] .approval-box {
  background: #3c3327;
  border-color: #5a4b35;
}
html[data-theme="dark"] .approval-box p { color: #e0cfad; }

.alert.error {
  background: #f8e9ea;
  border-color: #eccfd2;
  color: #963b47;
}
.alert.success {
  background: #e9f3ec;
  border-color: #cfe4d6;
  color: #2f704d;
}
html[data-theme="dark"] .alert.error {
  background: #482c32;
  border-color: #694049;
  color: #f0b8c0;
}
html[data-theme="dark"] .alert.success {
  background: #293f33;
  border-color: #3c604b;
  color: #b8dfc7;
}

.auth-page { background: var(--rf-bg); }
.auth-visual {
  background: linear-gradient(145deg, #302326 0%, #593a41 62%, #873f4b 100%);
}
html[data-theme="dark"] .auth-visual {
  background: linear-gradient(145deg, #191416 0%, #38252b 62%, #633640 100%);
}
.visual-content h1 span { color: #e0b7bd; }
.visual-content p { color: #e0d0d2; }
.visual-stats span, .visual-footer { color: #d1b6ba; }
.auth-panel { background: var(--rf-bg); }
.auth-card small, .auth-switch { color: var(--rf-muted); }
.auth-legal { color: var(--rf-muted); }

.skeleton { background: #e8e1dd; }
.skeleton::after {
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.72), transparent);
}
.skeleton-table-header { background: var(--rf-surface-soft); border-bottom-color: var(--rf-line); }
.skeleton-table-row { border-bottom-color: var(--rf-line); }
html[data-theme="dark"] .skeleton { background: #403538; }
html[data-theme="dark"] .skeleton::after {
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.09), transparent);
}

button:focus-visible, a:focus-visible, select:focus-visible,
input:focus-visible, textarea:focus-visible {
  outline: 3px solid rgba(135,63,75,.28);
  outline-offset: 2px;
}
html[data-theme="dark"] button:focus-visible,
html[data-theme="dark"] a:focus-visible,
html[data-theme="dark"] select:focus-visible,
html[data-theme="dark"] input:focus-visible,
html[data-theme="dark"] textarea:focus-visible {
  outline-color: rgba(196,122,133,.45);
}

/* Theme selector is available on every route, including login/register. */
.theme-control {
  position: fixed;
  z-index: 1000;
  top: 12px;
  right: 22px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 38px;
  padding: 3px 9px;
  border: 1px solid var(--rf-line);
  border-radius: 9px;
  background: var(--rf-surface);
  color: var(--rf-text);
  box-shadow: 0 4px 16px rgba(45, 31, 34, .08);
}
.theme-control-icon {
  color: var(--rf-primary);
  font-size: 15px;
  line-height: 1;
}
.theme-control select {
  min-height: 29px;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--rf-text);
  font-size: 11px;
  font-weight: 650;
  cursor: pointer;
}
.theme-control select:focus-visible {
  outline: 2px solid var(--rf-primary);
  outline-offset: 2px;
  border-radius: 4px;
}
.topbar-right { margin-right: 150px; }

.role-label {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 5px 9px;
  font-size: 10px;
  font-weight: 700;
}
.customer-role {
  background: #eee8e5;
  color: #675b5d;
}
.admin-role {
  background: var(--rf-primary-soft);
  color: var(--rf-primary-text);
}
html[data-theme="dark"] .customer-role {
  background: #40373a;
  color: #d5c8ca;
}

@media (max-width: 760px) {
  .theme-control {
    top: 8px;
    right: 9px;
    min-height: 34px;
    padding: 2px 6px;
  }
  .theme-control select { font-size: 10px; }
  .topbar-right { margin-right: 125px; }
}

@media (prefers-reduced-motion: no-preference) {
  body, .app-shell, .sidebar, .topbar, .panel, .metric-card,
  .form-panel, .auth-panel, .auth-visual, input, select, textarea,
  button, a {
    transition: background-color .18s ease, color .18s ease,
      border-color .18s ease, box-shadow .18s ease;
  }
}
